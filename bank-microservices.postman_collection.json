            "url": "{{gatewayUrl}}/auth/health"
          },
          "response": []
        },
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup accepted', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Public. Creates auth user and user profile.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Ivanov\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/auth/signup"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login sets auth cookies', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('at=');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Public. Sets HttpOnly cookies `at` and `rt`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Refresh Tokens",
          "request": {
            "method": "POST",
            "header": [],
            "description": "Public route, but requires `rt` cookie from login.",
            "url": "{{gatewayUrl}}/auth/refresh"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "Public route, but requires `rt` cookie from login. Clears auth cookies.",
            "url": "{{gatewayUrl}}/auth/logout"
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Requires authenticated active user. authUserId is read from the `at` cookie subject. Revokes active refresh tokens and sets a new HttpOnly `rt` cookie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
