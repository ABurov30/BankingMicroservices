# Site URL
SITE_URL=https://buro-bank.ru:5173

# GitHub Packages token used by Docker build to download private dependencies.
GITHUB_TOKEN=replace_me

# Image Tag
IMAGE_TAG=dev

AUTH_NAME=auth-service
AUTH_PORT=8081
AUTH_GRPC_PORT=8090

AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_PORT=5432
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_password

# Local run: use localhost and the host-mapped Postgres port.
AUTH_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_SPRING_DATASOURCE_USERNAME=auth_user
AUTH_SPRING_DATASOURCE_PASSWORD=auth_password

KAFKA_BOOTSTRAP_SERVERS=localhost:29092

SCHEMA_REGISTRY_URL=http://localhost:9081

JWT_PRIVATE_KEY_PATH=../secrets/private.pem
JWT_PUBLIC_KEY_PATH=../secrets/public.pem
JWT_PRIVATE_KEY_HOST_PATH=../secrets/private.pem
JWT_PUBLIC_KEY_HOST_PATH=../secrets/public.pem
JWT_PRIVATE_KEY_CONTAINER_PATH=/secrets/private.pem
JWT_PUBLIC_KEY_CONTAINER_PATH=/secrets/public.pem

# Development outbox polling; production values should be sized from metrics.
BANKING_OUTBOX_POLL_INTERVAL_MS=500
BANKING_OUTBOX_INITIAL_DELAY_MS=5000
BANKING_OUTBOX_BATCH_SIZE=50
BANKING_OUTBOX_MAX_IN_FLIGHT=50
BANKING_OUTBOX_LEASE_TIMEOUT_MS=360000
BANKING_OUTBOX_RETRY_DELAY_MS=5000
BANKING_OUTBOX_MAX_ATTEMPTS=5
KAFKA_PRODUCER_MAX_BLOCK_MS=5000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=30000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=10000

# Create the first service administrator; enable only with credentials configured.
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@bank.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
