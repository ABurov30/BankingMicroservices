# GitHub Packages token used by Docker build to download private dependencies.
GITHUB_TOKEN=replace_me

# Image Tag
IMAGE_TAG=dev

# Site Url
SITE_URL=http://localhost:5173

# Auth cookies
# Leave AUTH_COOKIE_DOMAIN empty for host-only cookies.
# Use the shared parent domain, for example buro-bank.ru, when the UI and gateway use subdomains.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=false

API_GATEWAY_NAME=api-gateway
API_GATEWAY_PORT=8080

# Local run: gateway connects to services running on the host.
AUTH_GRPC_HOST=localhost
AUTH_GRPC_PORT=8090

USER_GRPC_HOST=localhost
USER_GRPC_PORT=8091

ACCOUNT_GRPC_HOST=localhost
ACCOUNT_GRPC_PORT=8092

CARD_GRPC_HOST=localhost
CARD_GRPC_PORT=8093

TRANSACTION_GRPC_HOST=localhost
TRANSACTION_GRPC_PORT=8094

NOTIFICATION_GRPC_HOST=localhost
NOTIFICATION_GRPC_PORT=8095
NOTIFICATION_PORT=8086

JWT_PUBLIC_KEY_PATH=./secrets/public.pem
JWT_PUBLIC_KEY_HOST_PATH=./secrets/public.pem
JWT_PUBLIC_KEY_CONTAINER_PATH=/secrets/public.pem

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:9081

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
